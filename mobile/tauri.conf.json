{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meltemi",
  "version": "0.2.0",
  "identifier": "dev.meltemi.mobile",
  "build": {
    "frontendDist": "../desktop/ui/dist",
    "devUrl": "http://localhost:1420/mobile.html",
    "beforeDevCommand": "npm run dev --prefix desktop/ui",
    "beforeBuildCommand": "npm run build --prefix desktop/ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Meltemi",
        "url": "mobile.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "The Agent Boss's remote post"
  }
}
