{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meltemi.dev/fixtures/codex-app-server.schema.json",
  "title": "Server wire of the scripted provider (fixture)",
  "description": "The wire mock-codex-wire speaks, dumped by `generate-json-schema` exactly as the official CLI dumps its own. This is the fixture's contract, frozen for the supported version, and it is what CI can validate against without a provider binary; the authoritative per-version dump from the official CLI is vendored separately (adaptadores-propios-acp task 2.1). Where the two disagree, the official dump wins and this fixture is wrong.",
  "type": "object",
  "$defs": {
    "InitializeParams": {
      "type": "object",
      "properties": {
        "clientInfo": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name", "version"]
        }
      },
      "required": ["clientInfo"]
    },
    "InitializeResult": {
      "type": "object",
      "description": "Carries the server's version so the adapter can refuse a skew instead of assuming compatibility.",
      "properties": {
        "appServerVersion": { "type": "string" },
        "userAgent": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" }
          },
          "required": ["name", "version"]
        }
      },
      "required": ["appServerVersion"]
    },
    "NewThreadParams": {
      "type": "object",
      "properties": {
        "cwd": { "type": "string" }
      }
    },
    "NewThreadResult": {
      "type": "object",
      "properties": {
        "threadId": { "type": "string" }
      },
      "required": ["threadId"]
    },
    "SendUserTurnParams": {
      "type": "object",
      "properties": {
        "threadId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "text": { "type": "string" }
            },
            "required": ["type"]
          }
        }
      },
      "required": ["threadId", "items"]
    },
    "SendUserTurnResult": {
      "type": "object",
      "properties": {
        "turnId": { "type": "string" },
        "status": { "enum": ["completed", "interrupted", "failed"] }
      },
      "required": ["turnId", "status"]
    },
    "InterruptTurnParams": {
      "type": "object",
      "properties": {
        "threadId": { "type": "string" },
        "turnId": { "type": "string" }
      },
      "required": ["threadId"]
    },
    "ThreadEventNotification": {
      "type": "object",
      "description": "The streamed conversation: turn boundaries and the items that make a turn.",
      "properties": {
        "threadId": { "type": "string" },
        "turnId": { "type": "string" },
        "event": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "turn.started",
                "turn.completed",
                "turn.failed",
                "item.started",
                "item.updated",
                "item.completed"
              ]
            },
            "item": { "$ref": "#/$defs/Item" },
            "usage": { "$ref": "#/$defs/Usage" }
          },
          "required": ["type"]
        }
      },
      "required": ["threadId", "event"]
    },
    "Item": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "enum": ["agent_message", "reasoning", "command_execution", "file_change"] },
        "text": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "type"]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": { "type": "integer" },
        "output_tokens": { "type": "integer" }
      }
    },
    "ApplyPatchApprovalParams": {
      "type": "object",
      "description": "Asked by the server, decided by Meltemi's permission proxy — never by the adapter.",
      "properties": {
        "threadId": { "type": "string" },
        "turnId": { "type": "string" },
        "callId": { "type": "string" },
        "fileChanges": { "type": "object" },
        "reason": { "type": "string" }
      },
      "required": ["threadId", "callId", "fileChanges"]
    },
    "ApplyPatchApprovalResult": {
      "type": "object",
      "properties": {
        "decision": { "enum": ["approved", "approved_for_session", "denied", "abort"] }
      },
      "required": ["decision"]
    }
  },
  "properties": {
    "clientRequests": {
      "type": "object",
      "properties": {
        "initialize": {
          "type": "object",
          "properties": {
            "params": { "$ref": "#/$defs/InitializeParams" },
            "result": { "$ref": "#/$defs/InitializeResult" }
          }
        },
        "newThread": {
          "type": "object",
          "properties": {
            "params": { "$ref": "#/$defs/NewThreadParams" },
            "result": { "$ref": "#/$defs/NewThreadResult" }
          }
        },
        "sendUserTurn": {
          "type": "object",
          "properties": {
            "params": { "$ref": "#/$defs/SendUserTurnParams" },
            "result": { "$ref": "#/$defs/SendUserTurnResult" }
          }
        },
        "interruptTurn": {
          "type": "object",
          "properties": {
            "params": { "$ref": "#/$defs/InterruptTurnParams" }
          }
        }
      }
    },
    "serverRequests": {
      "type": "object",
      "properties": {
        "applyPatchApproval": {
          "type": "object",
          "properties": {
            "params": { "$ref": "#/$defs/ApplyPatchApprovalParams" },
            "result": { "$ref": "#/$defs/ApplyPatchApprovalResult" }
          }
        }
      }
    },
    "serverNotifications": {
      "type": "object",
      "properties": {
        "thread/event": { "$ref": "#/$defs/ThreadEventNotification" }
      }
    }
  }
}
