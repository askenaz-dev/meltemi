# Scripted server wire: the provider CLI in its documented JSON-RPC 2.0 server
# mode, newline-delimited over stdio (adaptadores-propios-acp design D6).
#
# The method and event names below freeze the wire as observed for the
# supported version. They are a fixture, not the contract: the authoritative
# per-version dump comes from the official CLI's own schema generator and is
# vendored in task 2.1, which is what the conformance test validates the
# adapter's types against.
#
# 1. Handshake: the client initializes, the server answers with its version, so
#    the adapter can detect skew instead of assuming compatibility.
{"mock":"await-request","method":"initialize"}
{"mock":"respond","result":{"appServerVersion":"1.0.0","userAgent":{"name":"mock-codex-wire","version":"0.1.0"}}}
# 2. A thread is the conversation the ACP session maps onto.
{"mock":"await-request","method":"newThread"}
{"mock":"respond","result":{"threadId":"mock-thread-1"}}
# 3. A turn, streamed as items.
{"mock":"await-request","method":"sendUserTurn"}
{"mock":"notify","method":"thread/event","params":{"threadId":"mock-thread-1","turnId":"turn-1","event":{"type":"turn.started"}}}
{"mock":"notify","method":"thread/event","params":{"threadId":"mock-thread-1","turnId":"turn-1","event":{"type":"item.started","item":{"id":"item-1","type":"agent_message","text":""}}}}
{"mock":"notify","method":"thread/event","params":{"threadId":"mock-thread-1","turnId":"turn-1","event":{"type":"item.updated","item":{"id":"item-1","type":"agent_message","text":"Working on it."}}}}
{"mock":"notify","method":"thread/event","params":{"threadId":"mock-thread-1","turnId":"turn-1","event":{"type":"item.completed","item":{"id":"item-1","type":"agent_message","text":"Working on it."}}}}
# 4. The approval the server asks for: it must reach the permission proxy and
#    come back decided before anything proceeds.
{"mock":"request","method":"applyPatchApproval","params":{"threadId":"mock-thread-1","turnId":"turn-1","callId":"call-1","fileChanges":{"NOTES.md":{"add":{"content":"scripted\n"}}},"reason":"the scripted turn writes one file"}}
{"mock":"notify","method":"thread/event","params":{"threadId":"mock-thread-1","turnId":"turn-1","event":{"type":"item.completed","item":{"id":"item-2","type":"file_change","status":"completed"}}}}
# 5. The turn closes, and only then does the turn request get its answer.
{"mock":"notify","method":"thread/event","params":{"threadId":"mock-thread-1","turnId":"turn-1","event":{"type":"turn.completed","usage":{"input_tokens":120,"output_tokens":34}}}}
{"mock":"respond","result":{"turnId":"turn-1","status":"completed"}}
