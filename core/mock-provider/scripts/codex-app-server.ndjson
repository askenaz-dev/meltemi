{"mock":"notify","method":"item/started","params":{"item":{"type":"fileChange","id":"item-2","changes":[{"path":"/mock/project/NOTES.md","kind":{"type":"add"},"diff":"scripted\n"}],"status":"inProgress"},"threadId":"mock-thread-1","turnId":"turn-1","startedAtMs":1790000003000}}
