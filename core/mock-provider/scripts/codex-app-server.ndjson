{"mock":"notify","method":"turn/completed","params":{"threadId":"mock-thread-1","turn":{"id":"turn-1","items":[{"type":"agentMessage","id":"item-1","text":"Working on it.","phase":"commentary","memoryCitation":null,"delivery":null,"questions":null}],"itemsView":"summary","status":"completed","error":null,"startedAt":1790000001,"completedAt":1790000004,"durationMs":3000}}}
