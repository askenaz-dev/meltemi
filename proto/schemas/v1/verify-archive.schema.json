{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meltemi.dev/proto/v1/verify-archive.schema.json",
  "title": "sdd/verify · sdd/verify-mark · sdd/archive",
  "description": "The verbs that close the SDD cycle. verify builds a per-requirement checklist where each scenario is linked to a test (by the scenario→test naming convention), marked manually with a note, or unverified. archive folds a change's deltas into the living truth atomically (all capabilities or none), gated by complete verification or recorded exceptions, and preserves the change in the dated history.",
  "$defs": {
    "verifyParams": {
      "type": "object",
      "required": ["projectRoot", "change"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 }
      }
    },
    "verifyScenario": {
      "type": "object",
      "required": ["capability", "requirement", "scenario", "status"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["linked", "manual", "unverified"] },
        "note": { "type": "string" }
      }
    },
    "verifyResult": {
      "type": "object",
      "required": ["scenarios", "verified", "total", "complete"],
      "properties": {
        "scenarios": { "type": "array", "items": { "$ref": "#/$defs/verifyScenario" } },
        "verified": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" }
      }
    },
    "verifyMarkParams": {
      "type": "object",
      "required": ["projectRoot", "change", "scenario", "note"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "verifyMarkResult": {
      "type": "object",
      "required": ["marked"],
      "properties": {
        "marked": { "type": "boolean" }
      }
    },
    "exception": {
      "type": "object",
      "required": ["scenario", "justification"],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 }
      }
    },
    "archiveParams": {
      "type": "object",
      "required": ["projectRoot", "change"],
      "properties": {
        "projectRoot": { "type": "string", "minLength": 1 },
        "change": { "type": "string", "minLength": 1 },
        "confirm": { "type": "boolean" },
        "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } }
      }
    },
    "archiveResult": {
      "type": "object",
      "required": ["capabilities", "archivedTo", "projectionRegenerated"],
      "properties": {
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "archivedTo": { "type": "string", "minLength": 1 },
        "projectionRegenerated": { "type": "boolean" },
        "excepted": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
