{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meltemi.dev/proto/v1/session-event.schema.json",
  "title": "session event (JSONL record & session/event notification)",
  "description": "Versioned session event envelope. The same shape is (a) appended as one JSON line per event to the session's append-only JSONL log in the user data directory, and (b) streamed to the connected client as params of the `session/event` notification (wrapped with the session id).",
  "$comment": "`configValue` and `configOption` below are a verbatim copy of `session-config.schema.json#/$defs`. Copied rather than referenced because a cross-file $ref does not resolve when a $defs section is grafted onto a synthetic root, which is how every schema here is compiled for validation. `the_two_copies_of_the_config_option_shape_agree` in the conformance suite compares them and fails on the first divergence — the same answer this codebase gives everywhere it cannot remove a duplication: let a test hold the two ends together.",
  "$defs": {
    "turnStatus": {
      "type": "string",
      "enum": ["completed", "cancelled", "refused", "max_tokens", "max_turn_requests"]
    },
    "configValue": {
      "type": "object",
      "description": "One selectable value of a `select` option, as the agent announced it.",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The value's identifier — what is sent back to choose it."
        },
        "name": {
          "type": "string",
          "description": "Human-readable label the agent gave it."
        },
        "description": {
          "type": "string",
          "description": "The agent's own description, when it sent one."
        }
      }
    },
    "configOption": {
      "type": "object",
      "description": "One session configuration option, relayed verbatim from the agent. Meltemi adds no entry of its own: an embedded catalog of models would be the core assuming a provider and would rot silently with every model released.",
      "required": [
        "id",
        "name",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "The option's identifier — what is sent back to set it."
        },
        "name": {
          "type": "string",
          "description": "Human-readable label the agent gave it."
        },
        "description": {
          "type": "string",
          "description": "The agent's own description, when it sent one."
        },
        "category": {
          "type": "string",
          "description": "The ACP category verbatim (`model`, `mode`, `modelConfig`, `thoughtLevel`, or anything else the agent sent). A free string and not an enum because ACP leaves the space open and requires clients to handle categories they do not know; a closed enum would turn the next category the spec adds into a parse failure."
        },
        "type": {
          "type": "string",
          "enum": [
            "select",
            "boolean"
          ],
          "description": "The option's shape, mirroring ACP's own two kinds. It is what decides how a chosen value is read."
        },
        "currentValue": {
          "description": "The value in force right now: a value id for `select`, a boolean for `boolean`.",
          "type": [
            "string",
            "boolean"
          ]
        },
        "values": {
          "type": "array",
          "description": "Everything the agent said can be chosen. Present for `select` only.",
          "items": {
            "$ref": "#/$defs/configValue"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "currentValue",
              "values"
            ],
            "properties": {
              "currentValue": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "boolean"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "currentValue"
            ],
            "properties": {
              "currentValue": {
                "type": "boolean"
              }
            }
          }
        }
      ]
    },
    "sessionEvent": {
      "type": "object",
      "required": ["v", "ts", "type", "payload"],
      "properties": {
        "v": {
          "const": 1,
          "description": "Session event schema version. Independent from the protocolVersion; bumped only on breaking changes to this envelope."
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "Event timestamp, RFC 3339 / ISO 8601, UTC."
        },
        "type": { "type": "string" },
        "payload": { "type": "object" }
      },
      "oneOf": [
        {
          "properties": {
            "type": { "const": "session_started" },
            "payload": {
              "type": "object",
              "required": ["sessionId", "agentCommand", "projectRoot"],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": ["manual", "semi", "autonomous"],
                  "description": "How much this session was told it may decide on its own. Absent means no mode was declared, which is NOT the same as `manual` — an absent mode composes nothing, while manual takes back what the user's own rules would grant."
                },
                "sessionId": { "type": "string", "minLength": 1 },
                "agentCommand": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "projectRoot": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "prompt_sent" },
            "payload": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "refs_expanded" },
            "payload": {
              "type": "object",
              "required": ["expansions"],
              "properties": {
                "expansions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path", "bytes", "notFound", "truncated"],
                    "properties": {
                      "path": { "type": "string" },
                      "bytes": { "type": "integer", "minimum": 0 },
                      "notFound": { "type": "boolean" },
                      "truncated": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "agent_update" },
            "payload": {
              "type": "object",
              "required": ["update"],
              "properties": {
                "update": {
                  "type": "object",
                  "description": "ACP SessionUpdate forwarded verbatim, in emission order (agent_message_chunk, tool_call, plan, ...). Shape owned by the ACP contract."
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "permission_requested" },
            "payload": {
              "type": "object",
              "required": ["request"],
              "properties": {
                "request": {
                  "type": "object",
                  "description": "The forwarded permission request (see permission.schema.json#/$defs/requestParams)."
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "permission_decided" },
            "payload": {
              "type": "object",
              "required": ["outcome", "decidedBy"],
              "properties": {
                "outcome": {
                  "type": "object",
                  "description": "The decision returned to the agent (see permission.schema.json#/$defs/outcome)."
                },
                "denied": {
                  "type": "boolean",
                  "description": "Whether the decision denied the request. Recorded explicitly because the outcome shape cannot say: selecting a reject option looks like selecting an allow one. Absent in logs written before this field existed — read as unknown, never as an approval."
                },
                "mode": {
                  "type": "string",
                  "enum": ["manual", "semi", "autonomous"],
                  "description": "The autonomy mode in force when this was decided, recorded even where the mode changed nothing: a history that names it only where it intervened cannot be read backwards to say what the session was allowed to do. Absent means no mode was declared."
                },
                "decidedBy": {
                  "type": "string",
                  "enum": ["client", "default_deny", "timeout", "rule", "interrupted"],
                  "description": "client: the connected client answered; default_deny: no client connected; timeout: the client did not answer in time; rule: a persistent rule resolved it before escalation; interrupted: the turn it belonged to was interrupted, so there was no turn left for an answer to belong to."
                },
                "rule": {
                  "type": "object",
                  "description": "The rule that resolved it, present only when decidedBy is `rule` (see permission.schema.json#/$defs/rule): its effect, scope and matchers, so every grant is traceable."
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "mcp_injected" },
            "payload": {
              "type": "object",
              "required": ["servers"],
              "properties": {
                "servers": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Injected MCP server names only — never resolved env values or credentialed URLs."
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "mcp_not_delivered" },
            "payload": {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "config_options_announced" },
            "payload": {
              "type": "object",
              "required": ["options"],
              "properties": {
                "options": {
                  "type": "array",
                  "description": "The session configuration options the agent announced, verbatim. Emitted at the handshake and again as the agent reports them after one is set. The live-change control exists only where this event does: an agent that announced nothing leaves no event, and that absence is the whole answer.",
                  "items": {
                    "$ref": "#/$defs/configOption"
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "turn_completed" },
            "payload": {
              "type": "object",
              "required": ["stopReason"],
              "properties": {
                "stopReason": { "$ref": "#/$defs/turnStatus" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "turn_interrupted" },
            "payload": {
              "type": "object",
              "required": ["instruction"],
              "properties": {
                "instruction": {
                  "type": "string",
                  "description": "The instruction that relayed the interrupted turn."
                }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "checkpoint_created" },
            "payload": {
              "type": "object",
              "required": ["gitRef", "change", "task", "agent"],
              "properties": {
                "gitRef": { "type": "string" },
                "change": { "type": "string" },
                "task": { "type": "string" },
                "agent": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "checkpoint_restored" },
            "payload": {
              "type": "object",
              "required": ["gitRef", "change", "task", "agent", "irreversible"],
              "properties": {
                "gitRef": { "type": "string" },
                "change": { "type": "string" },
                "task": { "type": "string" },
                "agent": { "type": "string" },
                "irreversible": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "agent_resolved" },
            "payload": {
              "type": "object",
              "required": ["binary", "source", "level"],
              "properties": {
                "binary": { "type": "string" },
                "source": { "type": "string", "enum": ["profile", "catalog", "configured"] },
                "profile": { "type": "string" },
                "agentId": { "type": "string" },
                "level": { "type": "integer", "minimum": 1, "maximum": 4 }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "task_started" },
            "payload": {
              "type": "object",
              "required": ["change", "task", "agent"],
              "properties": {
                "change": { "type": "string" },
                "task": { "type": "string" },
                "agent": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "task_committed" },
            "payload": {
              "type": "object",
              "required": ["change", "task", "agent", "sha", "requirements"],
              "properties": {
                "change": { "type": "string" },
                "task": { "type": "string" },
                "agent": { "type": "string" },
                "sha": { "type": "string" },
                "requirements": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "instruction_queued" },
            "payload": {
              "type": "object",
              "required": ["instruction"],
              "properties": {
                "instruction": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "human_edit" },
            "payload": {
              "type": "object",
              "required": ["file"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "sessionId": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "usage_reported" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source"],
              "description": "Counters an official level-3 structured output reported. A counter the output did not declare is ABSENT, never zero; no field carries credentials or any account identifier.",
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "model": { "type": "string", "minLength": 1 },
                "inputTokens": { "type": "integer", "minimum": 0 },
                "outputTokens": { "type": "integer", "minimum": 0 },
                "cachedInputTokens": { "type": "integer", "minimum": 0 },
                "reasoningTokens": { "type": "integer", "minimum": 0 },
                "totalTokens": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "session_cancelled" },
            "payload": { "type": "object" }
          }
        },
        {
          "properties": {
            "type": { "const": "session_ended" },
            "payload": {
              "type": "object",
              "required": ["reason"],
              "properties": {
                "reason": { "type": "string" }
              }
            }
          }
        },
        {
          "properties": {
            "type": { "const": "error" },
            "payload": {
              "type": "object",
              "required": ["kind", "detail"],
              "properties": {
                "kind": { "type": "string" },
                "detail": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "notificationParams": {
      "type": "object",
      "description": "Params of the `session/event` notification (daemon -> client).",
      "required": ["sessionId", "event"],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "event": { "$ref": "#/$defs/sessionEvent" }
      }
    }
  }
}
